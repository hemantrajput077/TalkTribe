# Database
POSTGRES_USER=talktribe
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=talktribe_db
DATABASE_URL=postgresql+asyncpg://talktribe:change_this_in_production@postgres:5432/talktribe_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_V1_PREFIX=/api/v1

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
